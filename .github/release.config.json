{
  "defaultBranch": "main",
  "remote": "origin",
  "tagPrefix": "v",
  "versionFiles": ["package.json"],
  "lockfiles": ["bun.lock"],
  "lockfileCommand": ["bun", "install", "--lockfile-only"],
  "checkCommand": ["bun", "run", "release:check"],
  "localCheckCommand": ["bun", "run", "release:check"],
  "commitMessage": "chore: release {tag}",
  "publishMode": "npm",
  "publishPackage": "@yoyooyoooyoooo/agsx",
  "publishRegistry": "https://registry.npmjs.org",
  "allowPrerelease": false,
  "stableDistTag": "latest",
  "prereleaseDistTag": "next",
  "failedTagPolicy": "immutable",
  "releaseBranchPrefix": "release/"
}
