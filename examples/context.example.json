{
  "schema": "agsx.config.v1",
  "defaultContext": "development",
  "journalLimit": 128,
  "contexts": {
    "development": {
      "endpoint": "http://127.0.0.1:6666",
      "instanceId": "development",
      "auth": {
        "kind": "human",
        "credential": { "file": "secrets/development.token" }
      }
    },
    "build": {
      "endpoint": "https://primary.example.test",
      "instanceId": "build-primary",
      "auth": {
        "kind": "service",
        "credential": { "env": "BUILD_AGS_TOKEN" }
      },
      "publicUrls": { "forgejo": "https://forge.example.test" },
      "workload": {
        "adapter": "multica",
        "endpoint": "https://tasks.example.test",
        "issuerInstanceId": "task-issuer-instance",
        "workspaces": ["sample-workspace"]
      }
    }
  }
}
