{
  "schema": "agsx.operator.v1",
  "context": "build",
  "repository": "sample/project",
  "forgejo": {
    "endpoint": "https://forge.example.test",
    "credential": { "file": "./forgejo-operator.token" },
    "repository": "sample/project"
  },
  "desired": {
    "branch": "main",
    "private": true,
    "createIfMissing": false,
    "protection": {
      "enable_force_push": false
    },
    "labels": [{ "name": "needs-review", "color": "663399", "description": "Ready for review" }],
    "webhook": {
      "url": "https://primary.example.test/api/v3/hooks/forgejo",
      "secret": { "file": "./webhook.secret" },
      "events": ["push", "pull_request", "pull_request_review"]
    }
  }
}
